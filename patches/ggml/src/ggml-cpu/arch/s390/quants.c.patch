+void quantize_row_q8_K(const float * GGML_RESTRICT x, void * GGML_RESTRICT vy, int64_t k) {
+    assert(k % QK_K == 0);
+    const int64_t nb = k / QK_K;
+
+    block_q8_K * GGML_RESTRICT y = vy;
+
+#if defined(__VXE__) || defined(__VXE2__) || defined(__MVS__)
+    for (int64_t i = 0; i < nb; i++) {
+        const float * src = x + i * QK_K;
 
+        // Vectorized max/amax scan; on a +max/-max tie this picks the positive
+        // value (only flips the sign of d and the quants jointly)
+        float32x4_t vmax0 = vec_xl(0, src);
+        float32x4_t vmax1 = vec_xl(0, src + 4);
+        float32x4_t vmin0 = vmax0;
+        float32x4_t vmin1 = vmax1;
+        for (int j = 8; j < QK_K; j += 8) {
+            const float32x4_t v0 = vec_xl(0, src + j);
+            const float32x4_t v1 = vec_xl(0, src + j + 4);
+            vmax0 = vec_max(vmax0, v0);
+            vmax1 = vec_max(vmax1, v1);
+            vmin0 = vec_min(vmin0, v0);
+            vmin1 = vec_min(vmin1, v1);
+        }
+        const float32x4_t vmax = vec_max(vmax0, vmax1);
+        const float32x4_t vmin = vec_min(vmin0, vmin1);
 
+        const float fmax = MAX(MAX(vec_extract(vmax, 0), vec_extract(vmax, 1)),
+                               MAX(vec_extract(vmax, 2), vec_extract(vmax, 3)));
+        const float fmin = MIN(MIN(vec_extract(vmin, 0), vec_extract(vmin, 1)),
+                               MIN(vec_extract(vmin, 2), vec_extract(vmin, 3)));
+
+        const float amax = MAX(fmax, -fmin);
+        const float max = (fmax >= -fmin) ? fmax : fmin;
+
+        if (!amax) {
+            y[i].d = 0;
+            memset(y[i].qs, 0, QK_K);
+            memset(y[i].bsums, 0, QK_K/16 * sizeof(int16_t));
+            continue;
+        }
+
+        const float iscale = -127.f / max;
+        y[i].d = 1.f / iscale;
+
+        const float32x4_t vscale = vec_splats(iscale);
+
+        // Quantize in groups of 16 and compute block sums
+        // QK_K/16 = 16 groups, each group = 4 vectors of 4 floats
+        for (int g = 0; g < QK_K/16; g++) {
+            int32x4_t acc = vec_splats(0);
+            int32x4_t vi[4];
+
+            for (int j = 0; j < 4; j++) {
+                const float32x4_t v = vec_mul(vec_xl(0, src + g*16 + 4*j), vscale);
+                vi[j] = vec_signed(__builtin_s390_vfisb(v, 4, 1));
+                acc = vec_add(acc, vi[j]);
+            }
+
+            // saturating pack clamps to [-128, 127]
+            const int8x16_t q = vec_packs(vec_packs(vi[0], vi[1]), vec_packs(vi[2], vi[3]));
+            vec_xst(q, 0, y[i].qs + g*16);
+
+            y[i].bsums[g] = vec_extract(acc, 0) + vec_extract(acc, 1) +
+                            vec_extract(acc, 2) + vec_extract(acc, 3);
+        }
+    }
+#else
+    GGML_UNUSED(nb);
+    // scalar
+    quantize_row_q8_K_ref(x, y, k);
+#endif
+}
