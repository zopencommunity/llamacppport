+// ---------------------------------------------------------------------------
+// z17 / Telum II: vector-enhancements facility 3
+//
+// z17 adds VECTOR EVALUATE (VEVAL), which computes any 3-input boolean function
+// of three vector registers in one instruction - the z/Architecture counterpart
+// of x86 vpternlog. The K-quant dot products below are dominated by unpacking
+// rather than arithmetic (roughly 150 boolean/shift/permute ops against 18
+// multiply-adds), so collapsing the AND/OR/ANDC chains is worth real
+// instructions.
+//
+// The facility is not reachable through -march: Open XL 2.1 (clang 18) knows
+// only up to arch14, so the compiler never generates VEVAL and no
+// __VEC_ENHANCE3__ predefine exists. It is emitted through inline asm instead.
+// HLASM accepts the mnemonic; the emitted encoding was verified to be
+//
+//     veval 1,2,3,4,232   ->  E7 12 30 E8 40 88
+//
+// which matches the VRI-k layout in the Principles of Operation
+// ('E7' V1 V2 V3 //// I5 V4 RXB '88', RXB bits 36-39 carrying the register
+// MSBs) and matches a hand-assembled DC X'E71230E84088' byte for byte. Note the
+// leading blank in every asm template: HLASM parses column 1 as the label field.
+//
+// The binary keeps a z15 baseline, so every call site must be guarded by
+// ggml_s390x_has_vxe3(). Executing VEVAL on pre-z17 hardware is an operation
+// exception.
+// ---------------------------------------------------------------------------
+
+#if defined(__s390x__) || defined(__MVS__)
+
+// STFLE facility bits, Principles of Operation chapter 4:
+//   84  miscellaneous-instruction-extensions facility 4 (BDEPG, BEXTG)
+//   148 vector-enhancements facility 2  (z15)
+//   165 neural-network-processing-assist (z16)
+//   198 vector-enhancements facility 3  (z17: VEVAL, VGEM, VBLEND, ...)
+#define GGML_S390X_FAC_VXE2 148
+#define GGML_S390X_FAC_NNPA 165
+#define GGML_S390X_FAC_VXE3 198
+
+// getauxval()/HWCAP is Linux-only and reports none of the z17 bits, so query the
+// facility list directly. STFLE has been architected since z9, needs no new
+// mnemonic, and behaves identically under z/OS and Linux.
+static bool ggml_s390x_facility(int bit) {
+    static bool     initialised = false;
+    static uint64_t facilities[4];
+
+    if (!initialised) {
+        register unsigned long r0 __asm__("0") = 3; // doublewords - 1
+        memset(facilities, 0, sizeof(facilities));
+        __asm__ __volatile__(" stfle 0(%[p])"
+                             : "+d"(r0), "=m"(facilities)
+                             : [p] "a"(facilities)
+                             : "cc");
+        initialised = true;
+    }
+
+    return (facilities[bit / 64] >> (63 - (bit % 64))) & 1ULL;
+}
+
+static inline bool ggml_s390x_has_vxe3(void) {
+    return ggml_s390x_facility(GGML_S390X_FAC_VXE3);
+}
+
+#if defined(__MVS__)
+// The I5 immediate is a truth table. Per the instruction description, the bits
+// taken from the second, third and fourth operands are concatenated into a
+// 3-bit index, and the result bit is bit <index> of I5.
+//
+// z/Architecture numbers bits most-significant-first, so this is the mirror of
+// the x86 vpternlog convention and the immediates are NOT interchangeable:
+//
+//     I5 = sum over index of f(index) << (7 - index)
+//
+// Cross-checked against figure 22-3, which places AND(A,B,C) at row 00000
+// column 001 (I5 = 1) and MAJOR(A,B,C) at row 00010 column 111 (I5 = 23);
+// figure 22-3 encodes the row in I5 bits 0-4 and the column in bits 5-7.
+#define GGML_VEVAL_AND 1    // a & b & c
+#define GGML_VEVAL_MAJ 23   // majority(a, b, c)
+#define GGML_VEVAL_SEL 83   // (a & b) | (~a & c)
+
+#define GGML_VEVAL(r, a, b, c, imm) \
+    __asm__(" veval %0,%1,%2,%3," #imm : "=v"(r) : "v"(a), "v"(b), "v"(c))
+
+// Runtime self-check. VEVAL is emitted by hand rather than by the compiler and
+// cannot be executed on the z15 build machine, so the truth-table convention
+// above is confirmed on the target before any kernel relies on it. Returns true
+// when VEVAL is absent (kernels then never call it) or present and correct.
+bool ggml_s390x_veval_selftest(void) {
+    if (!ggml_s390x_has_vxe3()) {
+        return true;
+    }
+
+    // one byte per bit pattern, so all eight index values are exercised at once
+    const uint8x16_t a = vec_splats((uint8_t)0xF0);
+    const uint8x16_t b = vec_splats((uint8_t)0xCC);
+    const uint8x16_t c = vec_splats((uint8_t)0xAA);
+
+    uint8x16_t r_and, r_maj, r_sel;
+    GGML_VEVAL(r_and, a, b, c, 1);
+    GGML_VEVAL(r_maj, a, b, c, 23);
+    GGML_VEVAL(r_sel, a, b, c, 83);
+
+    // expected values derived independently, in plain C
+    const uint8_t want_and = (uint8_t)(0xF0 & 0xCC & 0xAA);
+    const uint8_t want_maj = (uint8_t)((0xF0 & 0xCC) | (0xF0 & 0xAA) | (0xCC & 0xAA));
+    const uint8_t want_sel = (uint8_t)((0xF0 & 0xCC) | ((uint8_t)~0xF0 & 0xAA));
+
+    for (int i = 0; i < 16; i++) {
+        if (r_and[i] != want_and || r_maj[i] != want_maj || r_sel[i] != want_sel) {
+            return false;
+        }
+    }
+
+    return true;
+}
+
+// Gate for the kernels: the facility must be present AND the truth-table
+// convention must have been confirmed on this machine. VEVAL is emitted by hand
+// and cannot be executed on the z15 build machine, so a wrong immediate would
+// otherwise corrupt weights silently. Checked once; on failure the kernels stay
+// on the plain vec_and/vec_or path.
+static bool ggml_s390x_veval_ok(void) {
+    static bool checked = false;
+    static bool ok      = false;
+
+    if (!checked) {
+        ok      = ggml_s390x_has_vxe3() && ggml_s390x_veval_selftest();
+        checked = true;
+    }
+
+    return ok;
+}
+
+// (a & b) | c - true at indices 1, 3, 5, 6 and 7, so
+// I5 = 2^6 + 2^4 + 2^2 + 2^1 + 2^0 = 87.
+#define GGML_VEVAL_ANDOR 87
+
+// The q5_K/q6_K nibble merges are all of this shape. Callers pass a
+// loop-invariant `use_veval` so the branch unswitches out of the inner loop
+// instead of costing more than the instruction it saves.
+static inline uint8x16_t ggml_or_and(uint8x16_t a, uint8x16_t b, uint8x16_t c, bool use_veval) {
+    if (use_veval) {
+        uint8x16_t r;
+        GGML_VEVAL(r, a, b, c, 87);
+        return r;
+    }
+
+    return vec_or(vec_and(a, b), c);
+}
