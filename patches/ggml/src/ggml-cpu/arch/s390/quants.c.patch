+// VECTOR ELEMENT ROTATE AND INSERT UNDER MASK computes, per the Principles of
+// Operation, dst = (dst & ~mask) | (rotl(src, rot) & mask). The K-quant nibble
+// merges are exactly that shape - take the low bits from one register and splice
+// a rotated field of another into a fixed bit range - so a shift, an AND and an
+// OR collapse into one instruction.
+//
+// This is the base vector facility (z13 and later), not a z17 addition, so it
+// needs no facility check and every s390x compiler knows it. Using the builtin
+// rather than inline asm keeps the assembler out of it entirely.
+//
+// Note vec_rl_mask() is NOT this instruction; it rotates without the
+// insert-under-mask semantics and gives a different answer.
+#define GGML_VERIM(dst, src, mask, rot) \
+    ((uint8x16_t)__builtin_s390_verimb((uint8x16_t)(dst), (uint8x16_t)(src), (uint8x16_t)(mask), (rot)))
+#endif
+
