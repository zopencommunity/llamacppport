diff --git a/ggml/src/ggml-zdnn/CMakeLists.txt b/ggml/src/ggml-zdnn/CMakeLists.txt
index 0a723ce4d..c7f0dff7c 100644
--- a/ggml/src/ggml-zdnn/CMakeLists.txt
+++ b/ggml/src/ggml-zdnn/CMakeLists.txt
@@ -34,3 +34,12 @@
 target_link_directories(ggml-zdnn PRIVATE ${ZDNN_LIB})
 
 target_compile_definitions(ggml-zdnn PRIVATE GGML_USE_ZDNN)
+
+# z/OS: ibm-clang follows the XL C ABI and packs enums into the smallest type
+# that fits. libzDNN is built with the same default, and zdnn_tensor_desc leads
+# with three enum fields, so this translation unit has to agree or dim1..dim4
+# land at the wrong offsets. Do NOT set this on Linux on Z, where libzdnn is
+# built by gcc with 4-byte enums.
+if (CMAKE_SYSTEM_NAME STREQUAL "OS390" OR GGML_ZDNN_SHORT_ENUMS)
+    target_compile_options(ggml-zdnn PRIVATE -fshort-enums)
+endif()
