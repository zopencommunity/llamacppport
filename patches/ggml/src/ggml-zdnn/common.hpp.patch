 #define GGML_ZDNN_NAME    "zDNN"
 #define GGML_ZDNN_VERSION ZDNN_VERNUM
 
-#define ZDNN_CHECK(stmt)                \
-    do {                                \
-        zdnn_status status = (stmt);    \
-        GGML_ASSERT(status == ZDNN_OK); \
+// ZDNN_ELEMENT_RANGE_VIOLATION sits in the ZDNN_WARNING class (0x00020000), not
+// in any error class: the operation completed and its result is usable, values
+// simply fell outside the DLFLOAT16 range and were saturated. Asserting on it
+// aborts inference mid-graph -- on z17 this kills prompt processing outright.
+// Accept the warning class; every real error still asserts.
+#define ZDNN_CHECK(stmt)                                                       \
+    do {                                                                       \
+        zdnn_status status = (stmt);                                           \
+        GGML_ASSERT(status == ZDNN_OK ||                                       \
+                    (status & 0xFFFF0000u) == ZDNN_WARNING);                   \
     } while (0);
 
