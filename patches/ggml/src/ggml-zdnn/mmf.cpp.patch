diff --git a/ggml/src/ggml-zdnn/mmf.cpp b/ggml/src/ggml-zdnn/mmf.cpp
index 3ac9cf3c9..68d78909e 100644
--- a/ggml/src/ggml-zdnn/mmf.cpp
+++ b/ggml/src/ggml-zdnn/mmf.cpp
@@ -1,5 +1,6 @@
 #include "ggml.h"
 #include "mmf.hpp"
+#include "utils.hpp"
 
 void ggml_zdnn_mul_mat_f(
     const ggml_backend_zdnn_context * ctx,
@@ -65,6 +66,17 @@
     GGML_ASSERT(inputs_extra->pre_tfm_desc.dim1  == inputs->ne[0]  && "inputs_extra->pre_tfm_desc.dim1 must match inputs->ne[0]");
     GGML_ASSERT(inputs_extra->pre_tfm_desc.dim2  == inputs->ne[1]  && "inputs_extra->pre_tfm_desc.dim2 must match inputs->ne[1]");
 
+    // Convert the operands now rather than in set_tensor. Every write to them
+    // has landed by this point, so the whole-tensor stickify sees complete data.
+    // is_transformed keeps weights converted once: their buffer is never
+    // invalidated, while activations are reset on each write.
+    if (!weights_extra->ztensor.is_transformed) {
+        ggml_zdnn_load_tensor(weights_extra->ztensor, weights->data);
+    }
+    if (!inputs_extra->ztensor.is_transformed) {
+        ggml_zdnn_load_tensor(inputs_extra->ztensor, inputs->data);
+    }
+
     ZDNN_CHECK(zdnn_matmul_transpose_op(&inputs_extra->ztensor, &weights_extra->ztensor, &bias_extra->ztensor,
                                         false, true, MATMUL_OP_ADDITION, &output_extra->ztensor));
     // TODO: Remove in the future as we are currently DLF16 -> FP32 then in the next op, FP32 -> DLF16 again. Inefficient.
