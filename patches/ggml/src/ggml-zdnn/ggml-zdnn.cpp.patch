diff --git a/ggml/src/ggml-zdnn/ggml-zdnn.cpp b/ggml/src/ggml-zdnn/ggml-zdnn.cpp
index 639b818..be1835e 100644
--- a/ggml/src/ggml-zdnn/ggml-zdnn.cpp
+++ b/ggml/src/ggml-zdnn/ggml-zdnn.cpp
@@ -10,6 +10,7 @@
 #include <vector>
 #include <memory>
 #include <csignal>  // raise(SIGTRAP)
+#include <cstdlib>  // getenv
 #include <unistd.h>
 
 static void ggml_zdnn_compute_forward_mul_mat(
@@ -109,7 +110,16 @@ static bool ggml_zdnn_supports_op(const ggml_backend_zdnn_device_context * ctx_d
                     case GGML_TYPE_BF16:
                         return true;
                     default:
-                        return false;
+                        // Quantised weights have no NNPA representation: the
+                        // accelerator's INT8 carries one scale per tensor while
+                        // GGUF carries one per block, so they cannot be fed
+                        // directly. With GGML_ZDNN_DEQUANT set they are instead
+                        // dequantised to DLFLOAT16 at first use, which is
+                        // near-lossless and lets the matmul run here. That trades
+                        // memory for prompt-processing speed, so it is opt-in.
+                        return ggml_zdnn_dequant_enabled() &&
+                               ggml_is_quantized(weights->type) &&
+                               ggml_get_type_traits(weights->type)->to_float != nullptr;
                 }
             } break;
 
@@ -236,6 +246,22 @@ static enum ggml_status ggml_backend_zdnn_buffer_init_tensor(ggml_backend_buffer
     zdnn_buffer->extra = nullptr;
     snprintf(zdnn_buffer->name, GGML_MAX_NAME, "%s", tensor->name);
 
+    // A tensor with a zero-sized dimension carries no data for the accelerator,
+    // but zdnn_generate_transformed_desc still rejects the descriptor built from
+    // it (ZDNN_INVALID_SHAPE on dim2, which is ne[1]) and the ZDNN_CHECK inside
+    // ggml_zdnn_init_tensor would abort inference outright. Batched decode hits
+    // this routinely -- llama-batched-bench aborts at any batch size -- so
+    // register the buffer with its ztensor left zeroed and skip both
+    // stickification and the MUL_MAT bias allocation below. buffer_size stays 0,
+    // which is what ggml_backend_zdnn_buffer_free_buffer already tests before
+    // releasing a ztensor, and no operation reads an empty tensor.
+    if (ggml_is_empty(tensor)) {
+        tensor->extra = zdnn_buffer.get();
+        ctx->buffers.push_back(std::move(zdnn_buffer));
+        ctx->n_buffers++;
+        return GGML_STATUS_SUCCESS;
+    }
+
     ggml_zdnn_init_tensor(zdnn_buffer.get(), tensor);
     tensor->extra = zdnn_buffer.get();
 
@@ -286,10 +312,24 @@ static void ggml_backend_zdnn_buffer_set_tensor(ggml_backend_buffer_t buffer, gg
 
     ggml_backend_zdnn_buffer * extra = (ggml_backend_zdnn_buffer *)tensor->extra;
 
-    // Fixes the LLAMA_SET_ROWS bug
-    // see: https://github.com/ggml-org/llama.cpp/issues/15414
-    if (tensor->buffer->usage == GGML_BACKEND_BUFFER_USAGE_COMPUTE && extra->ztensor.is_transformed) zdnn_reset_ztensor(&extra->ztensor);
-    if (extra->ztensor.is_transformed == false) ggml_zdnn_load_tensor(extra->ztensor, tensor->data);
+    // Only invalidate here. The conversion itself happens lazily, on first use
+    // in ggml_zdnn_mul_mat_f().
+    //
+    // Stickification is whole-tensor, but set_tensor is handed an offset/size
+    // and may be covering only part of the tensor. Converting here would read
+    // whatever the rest of the buffer happens to hold, which for a partially
+    // written tensor is uninitialised memory -- that lands in the ztensor as
+    // huge or NaN activations and the matmul then saturates or fails outright.
+    // Deferring to first use means every write has landed by the time the whole
+    // tensor is read.
+    //
+    // It also means tensors zDNN never looks at are never converted at all.
+    // ggml_zdnn_supports_op only routes MUL_MAT here, so an attention mask
+    // holding -inf no longer has to survive a DLFLOAT16 conversion it was never
+    // going to be used for.
+    //
+    // Retains the LLAMA_SET_ROWS fix: see ggml-org/llama.cpp#15414
+    if (extra->ztensor.is_transformed) zdnn_reset_ztensor(&extra->ztensor);
 
     GGML_UNUSED(buffer);
 }
@@ -559,6 +599,20 @@ static const char * ggml_backend_zdnn_reg_get_name(ggml_backend_reg_t reg) {
 }
 
 static size_t ggml_backend_zdnn_reg_device_count(ggml_backend_reg_t reg) {
+    // Setting GGML_DISABLE_ZDNN turns the accelerator off at run time, mirroring
+    // GGML_DISABLE_VULKAN. Reporting no devices is the same path taken on
+    // hardware without NNPA, so the scheduler simply falls back to CPU/BLAS.
+    // Evaluated once: this is called repeatedly during backend enumeration.
+    static const bool disabled = getenv("GGML_DISABLE_ZDNN") != nullptr;
+    if (disabled) {
+        static bool logged = false;
+        if (!logged) {
+            logged = true;
+            GGML_LOG_INFO("%s: zDNN backend disabled by GGML_DISABLE_ZDNN\n", __func__);
+        }
+        return 0;
+    }
+
     if (!zdnn_is_nnpa_installed()) {
         return 0;
     }
