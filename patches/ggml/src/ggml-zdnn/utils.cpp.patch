 void ggml_zdnn_load_tensor(zdnn_ztensor & ztensor, void * buffer) {
-    ZDNN_CHECK(zdnn_transform_ztensor(&ztensor, buffer));
+    // Use the saturating transform. Activations routinely exceed the DLFLOAT16
+    // range (+/- 8.57e9), and the plain zdnn_transform_ztensor treats that as
+    // ZDNN_CONVERT_FAILURE via FE_OVERFLOW/FE_INVALID, which aborts inference.
+    // Measured on z17: with saturation a 1e30 input returns ZDNN_OK and clamps
+    // to 8.57316e+09, while ordinary values round-trip exactly.
+    ZDNN_CHECK(zdnn_transform_ztensor_with_saturation(&ztensor, buffer));
 }
 
