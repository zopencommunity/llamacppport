+bool ggml_zdnn_dequant_enabled(void) {
+    // Opt-in: dequantising to DLFLOAT16 lets the accelerator take quantised
+    // matmuls, which is a large win for prompt processing, but the stickified
+    // copy is 2 bytes per weight on top of the quantised original. Generation
+    // reads more bytes per token as a result, so this is left to the operator
+    // rather than turned on by default. Evaluated once.
+    static const bool enabled = getenv("GGML_ZDNN_DEQUANT") != nullptr;
+    return enabled;
+}
+
+zdnn_data_types ggml_zdnn_ztensor_type(ggml_type type) {
+    // Quantised weights are dequantised before stickification, so the ztensor
+    // describes floats regardless of how the weights are stored on disk.
+    if (ggml_is_quantized(type)) {
+        return FP32;
+    }
+
+    return ggml_zdnn_type_mapping(type);
+}
+
+void ggml_zdnn_load_tensor_dequant(zdnn_ztensor & ztensor, const ggml_tensor * tensor) {
+    const int64_t n = ggml_nelements(tensor);
+
+    const ggml_type_traits * traits = ggml_get_type_traits(tensor->type);
+    GGML_ASSERT(traits->to_float != nullptr && "no dequantiser for this type");
+
+    // Transient: this runs once per weight, and the ztensor keeps the result.
+    float * scratch = (float *) malloc((size_t) n * sizeof(float));
+    if (scratch == nullptr) {
+        GGML_LOG_ERROR("%s: could not allocate %.1f MiB to dequantise '%s'\n",
+                       __func__, (double)((size_t) n * sizeof(float)) / (1024.0 * 1024.0),
+                       tensor->name);
+        GGML_ABORT("zdnn: dequantisation buffer allocation failed");
+    }
+
+    traits->to_float(tensor->data, scratch, n);
+    ggml_zdnn_load_tensor(ztensor, scratch);
+
+    free(scratch);
+}
+
 void ggml_zdnn_load_tensor(zdnn_ztensor & ztensor, void * buffer) {
-    ZDNN_CHECK(zdnn_transform_ztensor(&ztensor, buffer));
+    const zdnn_status status = zdnn_transform_ztensor(&ztensor, buffer);
+
+    if (status == ZDNN_OK || (status & 0xFFFF0000u) == ZDNN_WARNING) {
+        return;
+    }
+
+    // Stickification can fail outright on Inf/NaN: zdnn rejects those for FP16
+    // even with saturation (verified on z17: -inf and NaN both give
+    // ZDNN_CONVERT_FAILURE, while fp16 max 65504 succeeds). Every tensor placed
+    // in a zDNN buffer is stickified, but ggml_zdnn_supports_op only ever routes
+    // MUL_MAT here, so this is typically a tensor zDNN never reads -- an
+    // attention mask holding -inf, for instance. Leave the ztensor untransformed
+    // rather than aborting inference. If such a tensor really is consumed by a
+    // matmul, zdnn_matmul_transpose_op rejects the untransformed operand and
+    // ZDNN_CHECK in mmf.cpp reports it at the point of use.
+    static bool warned = false;
+    if (!warned) {
+        warned = true;
+        GGML_LOG_WARN("%s: zDNN stickification failed (status 0x%08x); leaving the "
+                      "tensor untransformed. This is expected for tensors holding "
+                      "Inf/NaN, such as attention masks.\n", __func__, status);
+    }
 }
 
