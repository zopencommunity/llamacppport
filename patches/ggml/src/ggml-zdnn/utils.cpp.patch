-                );
-            } break;
+    // Populate pre_tfm_desc directly instead of going through the variadic
+    // zdnn_init_pre_transformed_desc(). ne[] is int64_t and the callee reads
+    // uint32_t varargs, and z/OS ibm-clang does not promote those the way gcc
+    // does. Writing the members also leaves no dim* undefined: the library
+    // helper only assigns the dims the layout uses.
+    zdnn_tensor_desc * d = &buffer->pre_tfm_desc;
 
-        default:
-            {
-                // For 4D tensors, GGML uses NCHW layout. However, because zDNN
-                // automatically transforms everything to NHWC, we will use it
-                // directly to avoid the performance penalty changing the
-                // layout and reshaping the tensor.
-                zdnn_init_pre_transformed_desc(
-                    ZDNN_NHWC,
-                    ggml_zdnn_type_mapping(tensor->type),
-                    &buffer->pre_tfm_desc,
-                    tensor->ne[3], tensor->ne[2], tensor->ne[1], tensor->ne[0]
-                );
+    d->type = ggml_zdnn_type_mapping(tensor->type);
 
-                // TODO: Consider adding a ggml check.
-                // TODO: If tensor = 4D, use ZDNN_NCHW by default.
-                // TODO: If tensor = 2D, use ZDNN_NHWC by default.
-            } break;
+    if (tensor->op == GGML_OP_MUL_MAT) {
+        d->layout = ZDNN_2D;
+        d->dim4   = 1;
+        d->dim3   = 1;
+        d->dim2   = (uint32_t)tensor->ne[1];
+        d->dim1   = (uint32_t)tensor->ne[0];
+    } else {
+        // For 4D tensors, GGML uses NCHW layout. However, because zDNN
