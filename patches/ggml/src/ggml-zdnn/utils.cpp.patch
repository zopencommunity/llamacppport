 void ggml_zdnn_load_tensor(zdnn_ztensor & ztensor, void * buffer) {
-    ZDNN_CHECK(zdnn_transform_ztensor(&ztensor, buffer));
+    const zdnn_status status = zdnn_transform_ztensor(&ztensor, buffer);
+
+    // Stickification reports ZDNN_ELEMENT_RANGE_VIOLATION when a value falls
+    // outside the DLFLOAT16 range (+/- ~8.6e9). The tensor is still usable, but
+    // those elements were clamped, so warn once rather than aborting the run or
+    // dropping the condition silently.
+    if (status == ZDNN_ELEMENT_RANGE_VIOLATION) {
+        static bool warned = false;
+        if (!warned) {
+            warned = true;
+            GGML_LOG_WARN("%s: tensor values exceed the DLFLOAT16 range and were "
+                          "clamped during stickification; results may be inaccurate\n",
+                          __func__);
+        }
+        return;
+    }
+
+    GGML_ASSERT(status == ZDNN_OK);
 }
 
 void ggml_zdnn_init_tensor(ggml_backend_zdnn_buffer * buffer, const ggml_tensor * tensor) {
-    switch (tensor->op) {
-        case GGML_OP_MUL_MAT:
-            {
-                zdnn_init_pre_transformed_desc(
