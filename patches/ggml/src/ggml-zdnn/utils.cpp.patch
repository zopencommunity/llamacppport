 void ggml_zdnn_load_tensor(zdnn_ztensor & ztensor, void * buffer) {
-    ZDNN_CHECK(zdnn_transform_ztensor(&ztensor, buffer));
+    // Saturating transform: activations routinely exceed the DLFLOAT16 range
+    // (+/- 8.57e9) and the plain transform reports that as ZDNN_CONVERT_FAILURE.
+    // Measured on z17, saturation returns ZDNN_OK and clamps to 8.57316e+09,
+    // while ordinary values round-trip exactly.
+    const zdnn_status status = zdnn_transform_ztensor_with_saturation(&ztensor, buffer);
+
+    if (status == ZDNN_OK || (status & 0xFFFF0000u) == ZDNN_WARNING) {
+        return;
+    }
+
+    // Stickification can still fail outright on Inf/NaN: zdnn rejects those for
+    // FP16 even with saturation (verified on z17: -inf and NaN both give
+    // ZDNN_CONVERT_FAILURE, while fp16 max 65504 succeeds). Every tensor placed
+    // in a zDNN buffer is stickified, but ggml_zdnn_supports_op only ever routes
+    // MUL_MAT here, so this is typically a tensor zDNN will never read -- an
+    // attention mask holding -inf, for instance. Leave the ztensor untransformed
+    // instead of aborting inference. If such a tensor really is consumed by a
+    // matmul, zdnn_matmul_transpose_op rejects the untransformed operand and
+    // ZDNN_CHECK in mmf.cpp reports it there.
+    static bool warned = false;
+    if (!warned) {
+        warned = true;
+        GGML_LOG_WARN("%s: zDNN stickification failed (status 0x%08x); leaving the "
+                      "tensor untransformed. This is expected for tensors holding "
+                      "Inf/NaN, such as attention masks.\n", __func__, status);
+    }
 }
 
