+void llama_model_loader::byteswap_tensor_data(const struct ggml_tensor * cur, void * data) const {
+    if (!byteswap) {
+        return;
+    }
+
+    const ggml_byteswap_t bswap = ggml_get_type_traits(cur->type)->byteswap;
+    if (bswap == nullptr) {
+        // types built out of single bytes (i8, mxfp4, ...) are endian independent
+        return;
+    }
+
+    bswap(data, ggml_nelements(cur) / ggml_blck_size(cur->type));
+}
